# ─── Database ──────────────────────────────────
DB_NAME=<database-name>
DB_USER=<database-user>
DB_PASSWORD=<database-password>
DB_HOST=<database-host>
DB_PORT=<database-port>

# Full URL (used by backend + ml-service in Docker)
DATABASE_URL=postgresql://<database-user>:<database-password>@<database-host>:<database-port>/<database-name>

# ─── Auth ───────────────────────────────────────
JWT_SECRET=<long-random-jwt-secret>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── External APIs (optional for hackathon demo) ─
OPENWEATHER_API_KEY=<openweather-api-key>
# AgMarknet API — use mock data if unavailable
AGMARKNET_API_KEY=

GROQ_API_KEY=<groq-api-key>
GROQ_MODEL=openai/gpt-oss-20b

# Twilio WhatsApp Sandbox (2-minute setup: create a Twilio account, open the
# WhatsApp Sandbox console, join it from your phone, then copy these values.)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── Frontend ────────────────────────────────────
# Set this to the deployed backend's public URL when the frontend is hosted
# separately. The FastAPI routes are /auth, /dashboard, /products, etc.
VITE_API_BASE_URL=http://localhost:8000
VITE_ML_BASE_URL=http://localhost:8001
