# ─── Database ──────────────────────────────────
DB_NAME=gramforecast
DB_USER=gramuser
DB_PASSWORD=grampassword
DB_HOST=localhost
DB_PORT=5432

# Full URL (used by backend + ml-service in Docker)
DATABASE_URL=postgresql://gramuser:grampassword@localhost:5432/gramforecast

# ─── Auth ───────────────────────────────────────
JWT_SECRET=supersecretjwtkeychangeinproduction
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── External APIs (optional for hackathon demo) ─
OPENWEATHER_API_KEY=your_openweather_key_here
# AgMarknet API — use mock data if unavailable
AGMARKNET_API_KEY=

# ─── Frontend ────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_ML_BASE_URL=http://localhost:8001
